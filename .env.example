# Run: python scripts/setup_env.py (creates random local credentials).
POSTGRES_PASSWORD=replace-with-random-local-admin-password
APP_DB_PASSWORD=replace-with-random-local-app-password
INTERNAL_API_KEY=replace-with-random-internal-service-secret
DEMO_TENANT_A_KEY=replace-with-random-tenant-a-api-key
DEMO_TENANT_B_KEY=replace-with-random-tenant-b-api-key
GRAFANA_PASSWORD=replace-with-random-grafana-password
MODEL_VERSION=v1
# Optional: only set this to enable sending retrieved feedback to OpenAI.
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=
